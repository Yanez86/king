msgid "A stone fireplace with a chimney, set against a wall. Cooks and warms like a campfire, more. Half its heat goes through a wooden wall at its back, none through stone."
msgstr "Un camino di pietra con la canna fumaria, addossato a un muro. Cucina e scalda come un fuoco da campo, di più. Metà del suo calore passa il muro di legno che ha alle spalle, la pietra no."

msgid "Hearth"
msgstr "Focolare"

msgid "+%d °C in the room"
msgstr "+%d °C nella stanza"

msgid ", +%s °C behind a wooden wall"
msgstr ", +%s °C dietro un muro di legno"

msgid "Outside: %d °C"
msgstr "Fuori: %d °C"

msgid "Walls keep %d%% toward %d °C"
msgstr "I muri tengono al %d%% verso %d °C"

msgid "Total: %d °C"
msgstr "In tutto: %d °C"

msgid "Heat lens"
msgstr "Vista calore"

msgid "%s: the storm tore tiles off the roof of %s."
